    {"id": "term.duzy_platnik", "title_pl": "Duży / mały płatnik składek", "term_pl": "duży płatnik składek", "synonyms_pl": ["płatnik powyżej 20 ubezpieczonych", "co najmniej 21 osób", "mały płatnik", "płatnik do 20 osób"], "definition_pl": "Duży płatnik: zgłasza do ubezpieczenia chorobowego co najmniej 21 osób i sam wypłaca zasiłki. Mały płatnik: najwyżej 20 osób – zasiłki wypłaca ZUS, płatnik przekazuje dokumenty w 7 dni.", "related_ids": ["term.platnik_zasilku"], "status": "current", "legal_refs": ["uz.art61.ust1", "uz.art61b.ust5"], "source_refs": [{"source_id": "src.zus_poradnik_2026", "locator": "s. 23"}], "verification": {"status": "verified_primary", "checked_at": "2026-11-21"}},
