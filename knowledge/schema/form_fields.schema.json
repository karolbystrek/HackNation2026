{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hacknation.local/knowledge/schema/form_fields.schema.json",
  "type": "object",
  "required": ["records"],
  "properties": {
    "$schema": {"type": "string"},
    "records": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "common.schema.json#/$defs/record"},
          {
            "required": ["applies_to_form_ids", "fields"],
            "properties": {
              "applies_to_form_ids": {"$ref": "common.schema.json#/$defs/idList"},
              "annex_ref": {"type": ["string", "null"]},
              "fields": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/field"}}
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
