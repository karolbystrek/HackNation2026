{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hacknation.local/knowledge/schema/leave_requests.schema.json",
  "type": "object",
  "required": ["records"],
  "properties": {
    "$schema": {"type": "string"},
    "records": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "common.schema.json#/$defs/record"},
          {
            "required": ["code", "leave_type", "requester_roles", "fields", "attachments"],
            "properties": {
              "code": {"type": "string", "pattern": "^W[0-9]+$"},
              "leave_type": {"enum": ["maternity", "maternity_conditions", "supplementary_maternity", "parental", "paternity", "combine_parental_with_work"]},
              "action": {"enum": ["grant", "grant_part", "resign_part", "take_over", "interrupt"]},
              "requester_roles": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/parentRole"}},
              "fields": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/field"}},
              "attachments": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/attachmentRule"}},
              "deadline_ids": {"$ref": "common.schema.json#/$defs/idList"},
              "employer_must_accept": {"type": "boolean"},
              "split_rules_pl": {"type": "string"},
              "withdrawal_rules_pl": {"type": "string"},
              "related_form_ids": {"$ref": "common.schema.json#/$defs/idList"}
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
